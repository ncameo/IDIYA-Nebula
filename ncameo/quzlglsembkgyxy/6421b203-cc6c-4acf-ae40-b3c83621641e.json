      "query": "SELECT VALUE {\n    \"id\": c.id,\n    \"Name\": c.Name,\n    \"Status\": c.Status\n}\nFROM c\nWHERE (\n    '@keywords' = '' OR '@keywords' = 'keywords' OR '@keywords' = 'null'\n    OR CONTAINS(LOWER(c.Name), LOWER('@keywords'))\n)\nORDER BY c.Name ASC",
