  "font": ".cameo .custom-sidebar-outer .custom-sidebar .custom-sidebar-body>.row {\n    margin: 0\n}\n\n.cameo .mb-0i {\n    margin-bottom: 0 !important;\n}\n\n.cameo .idiyaBox {\n    min-height: calc(100vh - 100px)\n}\n\n.cameo .market-card .row-p16>div>div {\n    height: 100%\n}\n\n.cameo .market-card .row-p16>div>div .card {\n    cursor: pointer;\n}\n\n.cameo .market-card .row-p16>div>div .card .card-img-top {\n    height: 150px;\n    line-height: 150px;\n    object-fit: cover;\n}\n\n.cameo .market-card .description-h {\n    max-height: 65px;\n    font-size: 14px;\n    color: #666;\n    overflow: hidden;\n}\n\n.cameo .market-card .badge {\n    margin: -10px auto;\n    box-shadow: 0 0 8px 0px #00000050;\n}\n\n.cameo .wb-chat-user {\n    width: 50px;\n    height: 50px;\n    object-fit: contain;\n    margin-right: 16px;\n    object-position: center;\n    border-radius: 50%;\n    background-color: #ededef;\n}\n\n.cameo .wb-chat-msg {\n    border-radius: 0 10px 10px 10px;\n    padding: 7px 10px;\n    background-color: #ededef;\n    position: relative;\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);\n}\n\n.cameo .wb-chat-msg::before {\n    content: '';\n    position: absolute;\n    left: -19px;\n    border-right: 10px solid #ededef;\n    border-bottom: 10px solid #ededef;\n    border-left: 10px solid transparent;\n    border-top: 10px solid transparent;\n\n}",
