      "webStyle": "html.cameo .left-card-row{gap:2px !important;} html.cameo .left-card-col{border:0 !important;}\nhtml.cameo .html-card{border-radius:0 !important;margin-bottom:0;overflow:inherit;transition:none;}\n.customers-item{display:flex;flex-direction:column;border:1px solid transparent;border-radius:6px;background:transparent;font:inherit;text-align:left;cursor:pointer;min-height:46px;padding:6px 10px;justify-content:center;color:inherit;text-decoration:none;}\n.customers-item:hover{background:var(--nc-hover,#f2f6fd);}\n.active-card .customers-item{background:var(--nc-active,#e8effa);border-color:var(--nc-active-border,#c3d6f5);}\n.customers-name{min-width:0;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:var(--nc-text,#1d2430);}\n.active-card .customers-name{color:var(--nc-primary,#24457c);font-weight:600;}\n.customers-info{display:flex;align-items:center;justify-content:space-between;gap:8px;}\n.customers-sub{flex:0 1 auto;line-height:1.3;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--nc-muted,#5f6876);font-size:12px;}\n.customers-badge{font-size:11px;line-height:1;padding:3px 6px;border-radius:9px;background:var(--nc-light,#eef1f5);}\n.customers-badge[data-value=\"Active\"]{background:var(--nc-success-bg,#e3f6ea);}\n.customers-badge[data-value=\"Inactive\"]{background:var(--nc-light,#eef1f5);}",
